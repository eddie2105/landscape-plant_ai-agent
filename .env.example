GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
# Hugging Face Space 可將 service account JSON 以單行字串設為 Secret；本機通常留空。
GOOGLE_SERVICE_ACCOUNT_JSON=
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini

PLANTS_SPREADSHEET_ID=your_plants_spreadsheet_id
PLANTS_WORKSHEET_GID=your_plants_worksheet_gid
PLANTS_WORKSHEET_NAME=plants

TREES_RAW_SPREADSHEET_ID=your_native_trees_spreadsheet_id
TREES_RAW_WORKSHEET_GID=your_trees_raw_worksheet_gid
TREES_RAW_WORKSHEET_NAME=trees_raw

TREES_CLEAN_SPREADSHEET_ID=your_native_trees_spreadsheet_id
TREES_CLEAN_WORKSHEET_GID=your_trees_clean_worksheet_gid
TREES_CLEAN_WORKSHEET_NAME=trees_clean

TLPG_RAW_SPREADSHEET_ID=your_planting_knowledge_spreadsheet_id
TLPG_RAW_WORKSHEET_GID=your_tlpg_raw_worksheet_gid
TLPG_RAW_WORKSHEET_NAME=tlpg_raw

TLPG_CLEAN_SPREADSHEET_ID=your_planting_knowledge_spreadsheet_id
TLPG_CLEAN_WORKSHEET_GID=your_tlpg_clean_worksheet_gid
TLPG_CLEAN_WORKSHEET_NAME=tlpg_clean

PLANTS_MERGED_SPREADSHEET_ID=your_planting_knowledge_spreadsheet_id
PLANTS_MERGED_WORKSHEET_GID=your_plants_merged_worksheet_gid
